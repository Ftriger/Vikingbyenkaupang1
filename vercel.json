    align-items: center; justify-content: center; margin-left: 4px; font-family: 'Cinzel', serif;
  }

  /* Login modal */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(26,16,8,0.8); z-index: 300;
    display: flex; align-items: center; justify-content: center; padding: 16px;
  }
  .modal {
    background: var(--white); width: 100%; max-width: 400px;
    border: 2px solid var(--amber); border-radius: 2px; padding: 32px;
  }
  .modal h2 { font-family: 'Cinzel', serif; font-size: 1.6rem; color: var(--smoke); margin-bottom: 24px; text-align: center; }
  .modal h2 span { display: block; font-size: 0.7rem; letter-spacing: 0.25em; color: var(--iron-light); margin-top: 4px; text-transform: uppercase; }
  .form-field { margin-bottom: 16px; }
  .form-field label { display: block; font-family: 'Cinzel', serif; font-size: 0.75rem; letter-spacing: 0.15em; color: var(--iron); text-transform: uppercase; margin-bottom: 6px; }
