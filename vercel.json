  .action-btn.add { color: var(--smoke); background: var(--amber); border-color: var(--amber); }
  .action-btn.add:hover { background: var(--amber-light); }

  /* Member area */
  .member-area { padding: 40px 24px; max-width: 800px; margin: 0 auto; }
