  }
  .add-to-cart:hover { background: var(--amber-light); }

  /* Cart */
  .cart-panel {
    position: fixed; right: 0; top: 0; bottom: 0; width: 340px;
    background: var(--white); box-shadow: -4px 0 20px rgba(0,0,0,0.2);
