    font-family: 'Cinzel', serif; font-size: 0.85rem; font-weight: 600;
    padding: 12px; width: 100%; cursor: pointer; letter-spacing: 0.1em;
    text-transform: uppercase; border-radius: 2px; transition: all 0.2s; margin-top: 4px;
  }
  .submit-btn:hover { background: var(--amber-light); }
  .cancel-btn {
    background: none; color: var(--iron); border: 1px solid var(--parchment-dark);
    font-family: 'Cinzel', serif; font-size: 0.8rem;
    padding: 10px; width: 100%; cursor: pointer; letter-spacing: 0.1em;
    text-transform: uppercase; border-radius: 2px; transition: all 0.2s; margin-top: 8px;
  }
  .cancel-btn:hover { border-color: var(--iron); }

  /* Admin dashboard */
  .dashboard { padding: 32px 24px; max-width: 1200px; margin: 0 auto; }
  .dash-title { font-family: 'Cinzel', serif; font-size: 2rem; color: var(--smoke); margin-bottom: 8px; }
  .dash-subtitle { color: var(--iron); font-style: italic; margin-bottom: 32px; }
  .dash-tabs { display: flex; gap: 4px; margin-bottom: 28px; border-bottom: 2px solid var(--parchment-dark); padding-bottom: 0; flex-wrap: wrap; }
  .dash-tab {
    background: none; border: none; font-family: 'Cinzel', serif; font-size: 0.8rem;
    letter-spacing: 0.12em; padding: 10px 18px; cursor: pointer; color: var(--iron);
    border-bottom: 3px solid transparent; margin-bottom: -2px; text-transform: uppercase; transition: all 0.2s;
  }
  .dash-tab.active { color: var(--amber); border-bottom-color: var(--amber); }
  .dash-tab:hover:not(.active) { color: var(--smoke); }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th { font-family: 'Cinzel', serif; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--iron); padding: 10px 12px; border-bottom: 2px solid var(--parchment-dark); text-align: left; }
  td { padding: 12px 12px; border-bottom: 1px solid var(--parchment-dark); color: var(--ink); font-size: 0.95rem; vertical-align: middle; }
  tr:hover td { background: rgba(200,120,10,0.04); }

  .action-btn {
    background: none; border: 1px solid currentColor; padding: 4px 10px;
    cursor: pointer; font-family: 'Cinzel', serif; font-size: 0.7rem;
    letter-spacing: 0.1em; text-transform: uppercase; border-radius: 2px; transition: all 0.2s;
