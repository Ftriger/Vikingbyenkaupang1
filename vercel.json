  .product-name { font-family: 'Cinzel', serif; font-size: 1rem; color: var(--smoke); margin: 6px 0; line-height: 1.3; }
  .product-desc { font-size: 0.85rem; color: var(--iron); font-style: italic; margin-bottom: 12px; line-height: 1.5; }
  .product-price { font-family: 'Cinzel', serif; font-size: 1.3rem; color: var(--ember); font-weight: 600; margin-bottom: 12px; }
  .product-stock { font-size: 0.75rem; color: var(--iron-light); margin-bottom: 12px; }
