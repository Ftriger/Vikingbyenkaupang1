  .site-logo span { display: block; font-size: 0.65rem; font-weight: 400; color: var(--iron-light); letter-spacing: 0.2em; text-transform: uppercase; }

  .site-nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
