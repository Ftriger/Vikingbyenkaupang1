          </div>
        ))}
        <p style={{color:'var(--iron-light)',fontSize:'0.85rem',marginTop:12,fontStyle:'italic'}}>30. juni – 16. august · kl. 11:00, 13:00 og 15:00</p>
      </div>
      <div className="member-card">
        <h3>📰 Siste artikler</h3>
        {articles.slice(0,3).map(a => (
          <div key={a.id} onClick={() => setViewArticle(a)} style={{cursor:'pointer',padding:'10px 0',borderBottom:'1px solid var(--parchment-dark)'}}>
            <span style={{fontSize:'0.7rem',background:'var(--ember)',color:'var(--white)',padding:'2px 8px',borderRadius:2,fontFamily:"'Cinzel',serif",letterSpacing:'0.1em',textTransform:'uppercase'}}>{a.category}</span>
            <p style={{fontFamily:"'Cinzel',serif",marginTop:6,color:'var(--smoke)',fontSize:'0.95rem'}}>{a.title}</p>
          </div>
        ))}
      </div>
      <div className="member-card">
        <h3>📬 Kontakt</h3>
        <p>post@kaupangprosjektet.no · +47 906 22 744</p>
      </div>
    </div>
  );

  const AdminPage = () => (
    <div className="dashboard">
      <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',flexWrap:'wrap',gap:12,marginBottom:8}}>
        <div>
          <h2 className="dash-title">Administrasjon</h2>
          <p className="dash-subtitle">Innlogget som {user.name} · Admin</p>
        </div>
      </div>
      <div className="dash-tabs">
        {[["artikler","Artikler"],["produkter","Produkter"],["oversikt","Oversikt"]].map(([k,l]) => (
          <button key={k} className={`dash-tab ${dashTab===k?'active':''}`} onClick={() => setDashTab(k)}>{l}</button>
        ))}
      </div>

      {dashTab === "artikler" && (
        <div>
          <div style={{display:'flex',justifyContent:'flex-end',marginBottom:16}}>
            <button className="action-btn add" onClick={() => setShowNewArticle(true)}>+ Ny artikkel</button>
          </div>
          <div className="table-wrap">
            <table>
              <thead><tr><th>Kategori</th><th>Tittel</th><th>Dato</th><th>Handlinger</th></tr></thead>
              <tbody>
                {articles.map(a => (
                  <tr key={a.id}>
                    <td><span style={{background:'var(--ember)',color:'var(--white)',padding:'2px 8px',borderRadius:2,fontFamily:"'Cinzel',serif",fontSize:'0.7rem',letterSpacing:'0.1em',textTransform:'uppercase'}}>{a.category}</span></td>
                    <td style={{fontWeight:600}}>{a.title}</td>
                    <td style={{color:'var(--iron-light)',fontSize:'0.85rem'}}>{a.date}</td>
                    <td>
                      <button className="action-btn edit" onClick={() => setEditArticle(a)}>Rediger</button>
                      <button className="action-btn delete" onClick={() => deleteArticle(a.id)}>Slett</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {dashTab === "produkter" && (
        <div>
          <div style={{display:'flex',justifyContent:'flex-end',marginBottom:16}}>
            <button className="action-btn add" onClick={() => setShowNewProduct(true)}>+ Legg til vare</button>
          </div>
          <div className="table-wrap">
            <table>
              <thead><tr><th>Vare</th><th>Kategori</th><th>Pris</th><th>Lager</th><th>Handlinger</th></tr></thead>
              <tbody>
                {products.map(p => (
                  <tr key={p.id}>
                    <td><span style={{marginRight:8}}>{p.image}</span><strong>{p.name}</strong></td>
                    <td style={{color:'var(--iron)'}}>{p.category}</td>
                    <td style={{fontFamily:"'Cinzel',serif",color:'var(--ember)',fontWeight:600}}>{p.price} kr</td>
                    <td style={{color:p.stock<5?'var(--ember)':'var(--iron)'}}>{p.stock} stk</td>
                    <td>
                      <button className="action-btn edit" onClick={() => setEditProduct(p)}>Rediger</button>
                      <button className="action-btn delete" onClick={() => deleteProduct(p.id)}>Slett</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {dashTab === "oversikt" && (
        <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(180px,1fr))',gap:20}}>
          {[["Artikler",articles.length,"📰"],["Produkter",products.length,"🛒"],["Handlekurv",cartCount,"🧺"],["Omsetning",cartTotal+" kr","💰"]].map(([l,v,i])=>(
            <div key={l} style={{background:'var(--white)',border:'1px solid var(--parchment-dark)',borderTop:'4px solid var(--amber)',padding:24,borderRadius:2,textAlign:'center'}}>
              <div style={{fontSize:'2rem'}}>{i}</div>
              <div style={{fontFamily:"'Cinzel',serif",fontSize:'1.8rem',color:'var(--ember)',margin:'8px 0',fontWeight:900}}>{v}</div>
              <div style={{fontSize:'0.75rem',color:'var(--iron-light)',letterSpacing:'0.15em',textTransform:'uppercase'}}>{l}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  );

  const ArticleView = () => (
    <div className="article-full">
      <button className="back-btn" onClick={() => setViewArticle(null)}>← Tilbake</button>
      <span className="article-cat">{viewArticle.category}</span>
      <h1>{viewArticle.title}</h1>
      <p style={{color:'var(--iron-light)',fontSize:'0.85rem',marginBottom:24,fontFamily:"'Cinzel',serif",letterSpacing:'0.1em'}}>{viewArticle.date}</p>
      <p style={{fontStyle:'italic',color:'var(--iron)',borderLeft:'3px solid var(--amber)',paddingLeft:16,marginBottom:24}}>{viewArticle.excerpt}</p>
      <div className="content">{viewArticle.content}</div>
      {user?.role === "admin" && (
        <button className="action-btn edit" style={{marginTop:24}} onClick={() => { setEditArticle(viewArticle); setViewArticle(null); setPage("artikler"); }}>Rediger artikkel</button>
      )}
    </div>
  );

  const renderPage = () => {
    if (viewArticle) return <ArticleView />;
    switch(page) {
      case "hjem": return <HomePage />;
      case "aktiviteter": return <ActivitiesPage />;
      case "artikler": return <ArticlesPage />;
      case "butikk": return <ShopPage />;
      case "besok": return <BesokPage />;
      case "admin": return user?.role === "admin" ? <AdminPage /> : <HomePage />;
      case "medlem": return user ? <MemberPage /> : <HomePage />;
      default: return <HomePage />;
    }
  };

  return (
    <>
      <style>{css}</style>

      <header className="site-header">
        <div className="header-inner">
          <button className="site-logo" style={{background:'none',border:'none',cursor:'pointer',textAlign:'left'}} onClick={() => { setPage("hjem"); setViewArticle(null); }}>
            Kaupang Vikingby
            <span>Norges første by · Larvik</span>
          </button>
          <nav className="site-nav">
            {navItems.map(({key,label}) => (
              <button key={key} className={`nav-btn ${page===key?'active':''}`} onClick={() => { setPage(key); setViewArticle(null); }}>{label}</button>
            ))}
            {user && (
              <>
                <button className={`nav-btn ${page==='admin'||page==='medlem'?'active':''}`} onClick={() => setPage(user.role==='admin'?'admin':'medlem')}>
                  {user.role==='admin'?'Admin':'Min side'}
                </button>
              </>
            )}
          </nav>
          <div style={{display:'flex',gap:8,alignItems:'center'}}>
            <button className="nav-btn" style={{position:'relative'}} onClick={() => setCartOpen(true)}>
              🧺 {cartCount > 0 && <span className="cart-count">{cartCount}</span>}
            </button>
            {user ? (
              <button className="login-btn logout" onClick={handleLogout}>Logg ut</button>
            ) : (
              <button className="login-btn" onClick={() => setShowLogin(true)}>Logg inn</button>
            )}
          </div>
        </div>
      </header>

      <main>{renderPage()}</main>

      <footer>
        <div className="footer-logo">Kaupang Vikingby</div>
        Kaupangveien 276, 3261 Larvik · <a href="tel:+4790622744">+47 906 22 744</a> · <a href="mailto:post@kaupangprosjektet.no">post@kaupangprosjektet.no</a><br/>
        <a href="https://www.facebook.com/vikingbyen/" target="_blank" rel="noopener">Følg oss på Facebook</a><br/>
        <span style={{color:'var(--iron-light)',fontSize:'0.8rem',marginTop:12,display:'block'}}>© 2026 Kaupang Vikingby · Drevet av Kaupangprosjektet · Historisk formidling siden år 800</span>
      </footer>

      {/* Cart */}
      {cartOpen && <div className="cart-overlay" onClick={() => setCartOpen(false)} />}
      <div className={`cart-panel ${cartOpen ? 'open' : ''}`}>
        <div style={{display:'flex',justifyContent:'space-between',alignItems:'center'}}>
          <div className="cart-title">Handlekurv</div>
          <button onClick={() => setCartOpen(false)} style={{background:'none',border:'none',cursor:'pointer',fontSize:'1.2rem',color:'var(--iron)'}}>✕</button>
        </div>
        {cart.length === 0 ? (
          <p style={{color:'var(--iron)',fontStyle:'italic',marginTop:24}}>Handlekurven er tom</p>
        ) : (
          <>
            {cart.map(item => (
              <div key={item.id} className="cart-item">
                <span style={{fontSize:'1.5rem'}}>{item.image}</span>
                <div className="cart-item-info">
                  <div className="cart-item-name">{item.name}</div>
                  <div className="cart-item-price">{item.price * item.qty} kr {item.qty > 1 && <span style={{color:'var(--iron-light)',fontSize:'0.8rem'}}>({item.qty}×)</span>}</div>
                </div>
                <button className="cart-item-remove" onClick={() => removeFromCart(item.id)}>✕</button>
              </div>
            ))}
            <div className="cart-total">Totalt: <strong>{cartTotal} kr</strong></div>
            <button className="checkout-btn" onClick={() => { notify("Bestilling mottatt! Vi tar kontakt."); setCart([]); setCartOpen(false); }}>Til kassen</button>
          </>
        )}
      </div>

      {/* Modals */}
      {showLogin && <LoginModal onLogin={handleLogin} onClose={() => setShowLogin(false)} />}
      {(editArticle || showNewArticle) && (
        <ArticleModal
          article={editArticle || null}
          isAdmin={user?.role === "admin"}
          onClose={() => { setEditArticle(null); setShowNewArticle(false); }}
          onSave={saveArticle}
        />
      )}
      {(editProduct || showNewProduct) && (
        <ProductModal
          product={editProduct || null}
          onClose={() => { setEditProduct(null); setShowNewProduct(false); }}
          onSave={saveProduct}
        />
      )}
      {toast && <Toast msg={toast} onDone={() => setToast(null)} />}
    </>
  );
}
