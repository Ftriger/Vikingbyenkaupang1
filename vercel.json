  .member-card h3 { font-family: 'Cinzel', serif; font-size: 1.1rem; color: var(--smoke); margin-bottom: 12px; }
  .member-card p { color: var(--iron); line-height: 1.7; }

  /* Article view */
  .article-full { padding: 40px 24px; max-width: 720px; margin: 0 auto; }
  .article-full h1 { font-family: 'Cinzel', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--smoke); margin: 12px 0 16px; line-height: 1.2; }
  .article-full .content { font-size: 1.1rem; line-height: 1.8; color: var(--iron); }
  .back-btn { background: none; border: none; color: var(--amber); font-family: 'Cinzel', serif; font-size: 0.8rem; letter-spacing: 0.1em; cursor: pointer; text-transform: uppercase; margin-bottom: 24px; padding: 0; }
  .back-btn:hover { color: var(--amber-light); }

  /* Notifications */
  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: var(--smoke); color: var(--parchment); padding: 12px 24px;
    border-radius: 2px; border-left: 4px solid var(--amber);
    font-family: 'Cinzel', serif; font-size: 0.85rem; z-index: 999;
    letter-spacing: 0.05em; box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    animation: slideUp 0.3s ease;
  }
  @keyframes slideUp { from { opacity: 0; transform: translateX(-50%) translateY(20px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }

  .divider { height: 1px; background: linear-gradient(to right, transparent, var(--parchment-dark), transparent); margin: 0; }

  /* Gallery */
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  .gallery-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 2px; cursor: pointer; transition: opacity 0.2s; }
  .gallery-img:hover { opacity: 0.85; }

  footer { background: var(--smoke); color: var(--iron-light); text-align: center; padding: 32px 24px; border-top: 3px solid var(--amber); font-size: 0.9rem; line-height: 1.8; }
  footer a { color: var(--amber); text-decoration: none; }
  footer a:hover { color: var(--amber-light); }
  footer .footer-logo { font-family: 'Cinzel', serif; color: var(--amber-light); font-size: 1.2rem; margin-bottom: 12px; }

  .user-pill { background: rgba(200,120,10,0.2); color: var(--amber-light); padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-family: 'Cinzel', serif; letter-spacing: 0.1em; }

  @media (max-width: 600px) {
    .hero { padding: 48px 16px 40px; }
    .hero-badges { gap: 12px; }
    .section { padding: 40px 16px; }
  }
`;

// ─── COMPONENTS ───────────────────────────────────────────────────────────────

function Toast({ msg, onDone }) {
  useEffect(() => { const t = setTimeout(onDone, 2800); return () => clearTimeout(t); }, []);
  return <div className="toast">{msg}</div>;
}

function LoginModal({ onLogin, onClose }) {
  const [u, setU] = useState(""); const [p, setP] = useState(""); const [err, setErr] = useState("");
  const handle = (e) => {
    e.preventDefault();
    const user = USERS[u.toLowerCase()];
    if (user && user.password === p) { onLogin(u.toLowerCase(), user); }
    else setErr("Feil brukernavn eller passord");
  };
  return (
    <div className="modal-overlay" onClick={(e) => e.target === e.currentTarget && onClose()}>
      <div className="modal">
        <h2>Innlogging<span>Kaupang Vikingby</span></h2>
        <form onSubmit={handle}>
          <div className="form-field"><label>Brukernavn</label><input value={u} onChange={e => setU(e.target.value)} placeholder="admin eller medlem" /></div>
          <div className="form-field"><label>Passord</label><input type="password" value={p} onChange={e => setP(e.target.value)} placeholder="••••••••" /></div>
          {err && <div className="form-error">{err}</div>}
          <button className="submit-btn" type="submit">Logg inn</button>
          <button className="cancel-btn" type="button" onClick={onClose}>Avbryt</button>
        </form>
        <p style={{marginTop:16,fontSize:'0.8rem',color:'var(--iron-light)',textAlign:'center'}}>
          Demo: admin / admin123 · eller · medlem / medlem123
        </p>
      </div>
    </div>
  );
}

function ArticleModal({ article, onClose, onSave, isAdmin }) {
  const [form, setForm] = useState(article || { title: "", category: "Arkeologi", excerpt: "", content: "", date: new Date().toISOString().split("T")[0] });
  const cats = ["Arkeologi", "Sosialhistorie", "Mat og oppskrifter", "Handel", "Fakta", "Arrangement"];
  const save = () => { if (!form.title || !form.content) return; onSave({ ...form, id: form.id || Date.now() }); onClose(); };
  if (!isAdmin) return null;
  return (
    <div className="modal-overlay" onClick={(e) => e.target === e.currentTarget && onClose()}>
      <div className="modal" style={{maxWidth:600}}>
        <h2>{article ? "Rediger artikkel" : "Ny artikkel"}<span style={{display:'block'}} /></h2>
        <div className="form-field"><label>Kategori</label>
          <select value={form.category} onChange={e => setForm({...form, category: e.target.value})}>
            {cats.map(c => <option key={c}>{c}</option>)}
          </select>
        </div>
        <div className="form-field"><label>Tittel</label><input value={form.title} onChange={e => setForm({...form, title: e.target.value})} /></div>
        <div className="form-field"><label>Ingress</label><textarea rows={2} value={form.excerpt} onChange={e => setForm({...form, excerpt: e.target.value})} /></div>
        <div className="form-field"><label>Innhold</label><textarea rows={5} value={form.content} onChange={e => setForm({...form, content: e.target.value})} /></div>
        <button className="submit-btn" onClick={save}>Lagre artikkel</button>
        <button className="cancel-btn" onClick={onClose}>Avbryt</button>
      </div>
    </div>
  );
}

function ProductModal({ product, onClose, onSave }) {
  const [form, setForm] = useState(product || { name: "", price: 0, description: "", category: "Håndverk", stock: 10, image: "🛒" });
  const emojis = ["🪬","📖","🗡️","🍯","⚔️","🛡️","🏹","🪓","📿","🧶","🪣","🔨"];
  const save = () => { if (!form.name || !form.price) return; onSave({ ...form, id: form.id || Date.now(), price: Number(form.price), stock: Number(form.stock) }); onClose(); };
  return (
    <div className="modal-overlay" onClick={(e) => e.target === e.currentTarget && onClose()}>
      <div className="modal" style={{maxWidth:500}}>
        <h2>{product ? "Rediger vare" : "Legg til vare"}<span style={{display:'block'}} /></h2>
        <div className="form-field"><label>Ikon</label>
          <div style={{display:'flex',flexWrap:'wrap',gap:8,marginBottom:4}}>
            {emojis.map(e=><button key={e} type="button" onClick={()=>setForm({...form,image:e})} style={{fontSize:'1.5rem',background:form.image===e?'var(--parchment-dark)':'none',border:'1px solid var(--parchment-dark)',borderRadius:4,padding:'4px 8px',cursor:'pointer'}}>{e}</button>)}
          </div>
        </div>
        <div className="form-field"><label>Navn</label><input value={form.name} onChange={e => setForm({...form, name: e.target.value})} /></div>
        <div className="form-field"><label>Kategori</label><input value={form.category} onChange={e => setForm({...form, category: e.target.value})} /></div>
        <div className="form-field"><label>Beskrivelse</label><textarea rows={2} value={form.description} onChange={e => setForm({...form, description: e.target.value})} /></div>
        <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>
          <div className="form-field"><label>Pris (kr)</label><input type="number" value={form.price} onChange={e => setForm({...form, price: e.target.value})} /></div>
          <div className="form-field"><label>Lager</label><input type="number" value={form.stock} onChange={e => setForm({...form, stock: e.target.value})} /></div>
        </div>
        <button className="submit-btn" onClick={save}>Lagre vare</button>
        <button className="cancel-btn" onClick={onClose}>Avbryt</button>
      </div>
    </div>
  );
}

