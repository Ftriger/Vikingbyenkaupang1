  .article-cat { background: var(--ember); color: var(--white); font-family: 'Cinzel', serif; font-size: 0.7rem; padding: 4px 10px; letter-spacing: 0.1em; text-transform: uppercase; display: inline-block; }
  .article-body { padding: 16px 20px 20px; }
