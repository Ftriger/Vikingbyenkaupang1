  .article-body .read-more { display: inline-block; margin-top: 12px; color: var(--amber); font-size: 0.85rem; font-family: 'Cinzel', serif; letter-spacing: 0.08em; }

  /* Shop */
  .shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
  .product-card {
    background: var(--white); border: 1px solid var(--parchment-dark); border-radius: 2px;
    padding: 20px; text-align: center; transition: all 0.2s;
  }
