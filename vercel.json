    width: 100%; border: 1px solid var(--parchment-dark); background: var(--cream);
    padding: 10px 12px; font-family: 'Crimson Text', serif; font-size: 1rem; color: var(--ink);
    border-radius: 2px; outline: none; transition: border 0.2s;
  }
  .form-field input:focus, .form-field textarea:focus, .form-field select:focus { border-color: var(--amber); }
  .form-field textarea { min-height: 100px; resize: vertical; }
